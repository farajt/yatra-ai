# Copy this file to .env and fill in your keys. Never commit .env.

# ── LLM: https://console.groq.com/keys ──
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ── Flights + hotels: https://serpapi.com/users/sign_up (free: 250 searches/month) ──
SERPAPI_API_KEY=

# ── Destination research: https://app.tavily.com ──
TAVILY_API_KEY=

# ── Storage (optional). Leave empty to use a local SQLite file (.data/yatra.db). ──
# Set a PostgreSQL URL only if you want Postgres, e.g. postgresql://user:password@localhost:5432/yatra_ai
DATABASE_URL=

# ── Optional: tracing with Langfuse (free at https://cloud.langfuse.com) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Optional ──
LOG_LEVEL=INFO
HTTP_USER_AGENT=yatra-ai/0.1 (portfolio project)
